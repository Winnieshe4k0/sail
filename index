<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Strogino Sail — Детский водный лагерь в Строгино</title>
  <meta name="description" content="Strogino Sail — детский водный лагерь на базе МКС в Строгино. Парусный спорт, SUP, командная среда и развитие через практику. Запись на лето 2025.">
  <meta property="og:title" content="Strogino Sail — Детский водный лагерь">
  <meta property="og:description" content="Парусный спорт, SUP и развитие ребёнка через воду. Строгино, МКС.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #F5E1C4;
      --amber: #FDB44E;
      --slate: #424242;
      --radius: 20px;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      font-family: 'DM Sans', sans-serif;
      color: var(--slate);
      overflow-x: hidden;
    }

    /* ── NAV ── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(245, 225, 196, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 48px;
      border-bottom: 1px solid rgba(66,66,66,0.1);
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }

    .nav-logo {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
    }

    .nav-logo video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      mix-blend-mode: multiply;
    }

    .nav-name {
      font-family: 'Caprasimo', cursive;
      font-size: 16px;
      color: var(--slate);
      letter-spacing: 0.5px;
    }

    .nav-links {
      display: flex;
      gap: 32px;
    }

    .nav-links a {
      font-size: 13px;
      color: var(--slate);
      opacity: 0.55;
      text-decoration: none;
      transition: opacity 0.2s;
    }

    .nav-links a:hover { opacity: 1; }

    .nav-btn {
      background: var(--slate);
      color: var(--bg);
      border: none;
      border-radius: 100px;
      padding: 10px 22px;
      font-size: 13px;
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .nav-btn:hover { opacity: 0.8; }

    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 4px;
    }

    .hamburger span {
      width: 22px;
      height: 1.5px;
      background: var(--slate);
      border-radius: 2px;
      transition: all 0.3s;
    }

    /* mobile menu */
    .mobile-menu {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: var(--bg);
      z-index: 200;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 32px;
    }

    .mobile-menu.open { display: flex; }

    .mobile-menu a {
      font-family: 'Caprasimo', cursive;
      font-size: 28px;
      color: var(--slate);
      text-decoration: none;
      opacity: 0.7;
    }

    .mobile-menu a:hover { opacity: 1; }

    .mobile-menu-close {
      position: absolute;
      top: 20px;
      right: 24px;
      font-size: 28px;
      cursor: pointer;
      opacity: 0.4;
      background: none;
      border: none;
      color: var(--slate);
      font-family: 'DM Sans', sans-serif;
    }

    /* ── HERO ── */
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 560px;
    }

    .hero-left {
      padding: 64px 48px 56px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 24px;
    }

    .eyebrow-line {
      width: 24px;
      height: 1.5px;
      background: var(--amber);
    }

    .eyebrow span {
      font-size: 10px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--amber);
      font-weight: 500;
    }

    h1 {
      font-family: 'Caprasimo', cursive;
      font-size: 58px;
      line-height: 1.05;
      margin-bottom: 10px;
    }

    h1 em {
      color: var(--amber);
      font-style: normal;
      display: block;
    }

    .hero-tagline {
      font-size: 10px;
      letter-spacing: 3.5px;
      text-transform: uppercase;
      opacity: 0.32;
      margin-bottom: 20px;
    }

    .hero-sub {
      font-size: 16px;
      line-height: 1.8;
      opacity: 0.62;
      margin-bottom: 36px;
      max-width: 400px;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: var(--amber);
      color: var(--slate);
      border: none;
      border-radius: 100px;
      padding: 14px 30px;
      font-size: 14px;
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 20px rgba(253,180,78,0.4);
    }

    .btn-ghost {
      background: transparent;
      color: var(--slate);
      border: 1.5px solid rgba(66,66,66,0.25);
      border-radius: 100px;
      padding: 13px 26px;
      font-size: 13px;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      opacity: 0.65;
      transition: opacity 0.2s;
    }

    .btn-ghost:hover { opacity: 1; }

    .hero-right {
      background: rgba(253,180,78,0.07);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .hero-right svg { width: 100%; height: 100%; }

    /* ── STATS ── */
    .stats-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid rgba(66,66,66,0.1);
      border-bottom: 1px solid rgba(66,66,66,0.1);
    }

    .stat-item {
      padding: 28px 48px;
      border-right: 1px solid rgba(66,66,66,0.1);
    }

    .stat-item:last-child { border-right: none; }

    .stat-num {
      font-family: 'Caprasimo', cursive;
      font-size: 26px;
      line-height: 1;
      margin-bottom: 4px;
    }

    .stat-label {
      font-size: 12px;
      opacity: 0.42;
    }

    /* ── PROGRAMS ── */
    .programs-section {
      padding: 72px 48px;
    }

    .section-label {
      font-size: 10px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--amber);
      font-weight: 500;
      margin-bottom: 10px;
    }

    .section-h2 {
      font-family: 'Caprasimo', cursive;
      font-size: 32px;
      color: var(--slate);
      line-height: 1.2;
      margin-bottom: 32px;
    }

    .programs-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .price-card {
      border: 1.5px solid rgba(66,66,66,0.12);
      border-radius: var(--radius);
      padding: 28px;
      background: rgba(255,255,255,0.38);
      position: relative;
      overflow: hidden;
      transition: transform 0.2s;
    }

    .price-card:hover { transform: translateY(-3px); }

    .price-card.featured {
      background: var(--slate);
      border-color: var(--slate);
    }

    .card-wave {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      opacity: 0.05;
      pointer-events: none;
    }

    .card-tag {
      display: inline-block;
      background: rgba(253,180,78,0.2);
      color: #9a5f00;
      font-size: 10px;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 100px;
      margin-bottom: 14px;
      font-weight: 500;
    }

    .price-card.featured .card-tag {
      background: rgba(253,180,78,0.18);
      color: var(--amber);
    }

    .card-name {
      font-family: 'Caprasimo', cursive;
      font-size: 20px;
      color: var(--slate);
      margin-bottom: 8px;
    }

    .price-card.featured .card-name { color: var(--bg); }

    .card-desc {
      font-size: 13px;
      opacity: 0.52;
      line-height: 1.7;
      margin-bottom: 22px;
    }

    .price-card.featured .card-desc { color: var(--bg); }

    .price-rows { display: flex; flex-direction: column; gap: 8px; }

    .price-row {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(66,66,66,0.08);
    }

    .price-row:last-child { border-bottom: none; padding-bottom: 0; }

    .price-row strong { font-weight: 500; }

    .price-card.featured .price-row {
      color: var(--bg);
      border-bottom-color: rgba(245,225,196,0.1);
    }

    /* ── PHILOSOPHY ── */
    .philosophy-section {
      padding: 72px 48px;
      background: rgba(66,66,66,0.03);
      border-top: 1px solid rgba(66,66,66,0.08);
    }

    .phil-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: center;
      margin-top: 32px;
    }

    .phil-quote-block {
      padding-left: 22px;
      border-left: 3px solid var(--amber);
    }

    .phil-quote {
      font-family: 'Caprasimo', cursive;
      font-size: 22px;
      line-height: 1.5;
      margin-bottom: 14px;
    }

    .phil-author {
      font-size: 11px;
      opacity: 0.38;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .phil-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .phil-item {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      font-size: 14px;
      line-height: 1.75;
      opacity: 0.65;
    }

    .phil-dot {
      width: 6px;
      height: 6px;
      background: var(--amber);
      border-radius: 50%;
      margin-top: 7px;
      flex-shrink: 0;
    }

    /* ── ABOUT ── */
    .about-section {
      padding: 72px 48px;
      border-top: 1px solid rgba(66,66,66,0.08);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      margin-top: 32px;
      align-items: start;
    }

    .about-text p {
      font-size: 15px;
      line-height: 1.85;
      opacity: 0.65;
      margin-bottom: 16px;
    }

    .about-text p:last-child { margin-bottom: 0; }

    .trainer-card {
      background: rgba(255,255,255,0.4);
      border: 1.5px solid rgba(66,66,66,0.1);
      border-radius: var(--radius);
      padding: 28px;
    }

    .trainer-avatar {
      width: 56px;
      height: 56px;
      background: rgba(253,180,78,0.25);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Caprasimo', cursive;
      font-size: 20px;
      color: var(--amber);
      margin-bottom: 16px;
    }

    .trainer-name {
      font-family: 'Caprasimo', cursive;
      font-size: 20px;
      margin-bottom: 4px;
    }

    .trainer-role {
      font-size: 12px;
      opacity: 0.45;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .trainer-desc {
      font-size: 13px;
      line-height: 1.75;
      opacity: 0.62;
    }

    /* ── CTA ── */
    .cta-section { padding: 0 48px 72px; }

    .cta-box {
      background: var(--slate);
      border-radius: 24px;
      padding: 56px 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

    .cta-waves {
      position: absolute;
      right: 0; top: 0; bottom: 0;
      height: 100%;
      opacity: 0.06;
      pointer-events: none;
    }

    .cta-h {
      font-family: 'Caprasimo', cursive;
      font-size: 30px;
      color: var(--bg);
      line-height: 1.3;
      max-width: 380px;
    }

    .cta-h span { color: var(--amber); }

    .cta-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
      position: relative;
      z-index: 1;
    }

    .btn-cta {
      background: var(--amber);
      color: var(--slate);
      border: none;
      border-radius: 100px;
      padding: 16px 36px;
      font-size: 15px;
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }

    .btn-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(253,180,78,0.4);
    }

    .cta-note {
      font-size: 12px;
      color: rgba(245,225,196,0.38);
    }

    /* ── FOOTER ── */
    footer {
      padding: 28px 48px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid rgba(66,66,66,0.1);
    }

    .footer-brand {
      font-family: 'Caprasimo', cursive;
      font-size: 14px;
      opacity: 0.35;
    }

    .footer-tagline {
      font-size: 10px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      opacity: 0.28;
    }

    .footer-contact {
      font-size: 12px;
      opacity: 0.4;
      text-align: right;
      line-height: 1.7;
    }

    /* ── MOBILE ── */
    @media (max-width: 768px) {
      nav {
        padding: 12px 20px;
      }

      .nav-links, .nav-btn { display: none; }
      .hamburger { display: flex; }

      .hero {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .hero-left {
        padding: 36px 20px 24px;
      }

      h1 { font-size: 42px; }

      .hero-sub { font-size: 14px; max-width: 100%; }

      .hero-actions {
        flex-direction: column;
      }

      .btn-primary, .btn-ghost {
        width: 100%;
        text-align: center;
        padding: 14px 20px;
      }

      .hero-right {
        height: 220px;
      }

      .stats-bar {
        grid-template-columns: 1fr;
      }

      .stat-item {
        padding: 18px 20px;
        border-right: none;
        border-bottom: 1px solid rgba(66,66,66,0.1);
      }

      .stat-item:last-child { border-bottom: none; }

      .programs-section {
        padding: 48px 20px;
      }

      .programs-grid {
        grid-template-columns: 1fr;
      }

      .philosophy-section {
        padding: 48px 20px;
      }

      .phil-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .about-section { padding: 48px 20px; }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .cta-section { padding: 0 20px 48px; }

      .cta-box {
        flex-direction: column;
        padding: 36px 28px;
        gap: 28px;
        align-items: flex-start;
      }

      .cta-right {
        align-items: stretch;
        width: 100%;
      }

      .btn-cta { text-align: center; }

      .cta-note { text-align: center; }

      footer {
        padding: 20px;
        flex-direction: column;
        gap: 8px;
        text-align: center;
      }

      .footer-contact { text-align: center; }
    }
  </style>
</head>
<body>

<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">
  <button class="mobile-menu-close" id="menuClose">✕</button>
  <a href="#programs" onclick="closeMobileMenu()">Программы</a>
  <a href="#philosophy" onclick="closeMobileMenu()">Философия</a>
  <a href="#about" onclick="closeMobileMenu()">О нас</a>
  <a href="#cta" onclick="closeMobileMenu()">Записаться</a>
</div>

<!-- NAV -->
<nav>
  <a class="nav-brand" href="#">
    <div class="nav-logo">
      <video autoplay loop muted playsinline>
        <source src="strogino_sail_logo.webm" type="video/webm">
      </video>
    </div>
    <span class="nav-name">Strogino Sail</span>
  </a>
  <div class="nav-links">
    <a href="#programs">Программы</a>
    <a href="#philosophy">Философия</a>
    <a href="#about">О нас</a>
    <a href="#cta">Контакты</a>
  </div>
  <button class="nav-btn" onclick="document.getElementById('cta').scrollIntoView({behavior:'smooth'})">Записаться →</button>
  <div class="hamburger" id="hamburger">
    <span></span><span></span><span></span>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-left">
    <div class="eyebrow">
      <div class="eyebrow-line"></div>
      <span>Строгино · МКС · Москва</span>
    </div>
    <h1>Вода —<br>честная<em>среда</em></h1>
    <div class="hero-tagline">water · sail · community</div>
    <p class="hero-sub">Детский водный лагерь на базе МКС в Строгино. Парусный спорт, команда и развитие через практику — в месте с настоящей историей.</p>
    <div class="hero-actions">
      <button class="btn-primary" onclick="document.getElementById('cta').scrollIntoView({behavior:'smooth'})">Записать ребёнка</button>
      <button class="btn-ghost" onclick="document.getElementById('programs').scrollIntoView({behavior:'smooth'})">Узнать больше</button>
    </div>
  </div>
  <div class="hero-right">
    <svg viewBox="0 0 480 560" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="280" cy="230" r="180" fill="#FDB44E" opacity="0.14"/>
      <circle cx="280" cy="230" r="148" fill="#FDB44E" opacity="0.14"/>
      <circle cx="280" cy="230" r="118" fill="#FDB44E" opacity="0.2"/>
      <line x1="238" y1="105" x2="250" y2="326" stroke="#FDB44E" stroke-width="9" opacity="0.12"/>
      <line x1="268" y1="100" x2="278" y2="330" stroke="#FDB44E" stroke-width="7" opacity="0.1"/>
      <line x1="300" y1="103" x2="292" y2="328" stroke="#FDB44E" stroke-width="10" opacity="0.1"/>
      <line x1="332" y1="116" x2="318" y2="324" stroke="#FDB44E" stroke-width="8" opacity="0.09"/>
      <!-- hull -->
      <path d="M168 342 Q230 368 292 342 Q302 360 280 372 Q230 389 178 372 Q156 360 168 342Z"
        fill="#FDB44E" opacity="0.38" stroke="#424242" stroke-width="2"/>
      <!-- mast -->
      <line x1="230" y1="204" x2="230" y2="348" stroke="#424242" stroke-width="2.5" stroke-linecap="round"/>
      <!-- main sail -->
      <path d="M230 208 L308 328 L230 328 Z" fill="#F5E1C4" stroke="#424242" stroke-width="2" stroke-linejoin="round"/>
      <!-- jib -->
      <path d="M230 242 L174 328 L230 328 Z" fill="rgba(66,66,66,0.07)" stroke="#424242" stroke-width="1.8" stroke-linejoin="round"/>
      <!-- child head -->
      <circle cx="204" cy="314" r="10" fill="#424242"/>
      <!-- hair spikes -->
      <line x1="199" y1="305" x2="196" y2="296" stroke="#424242" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="204" y1="304" x2="203" y2="295" stroke="#424242" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="209" y1="305" x2="211" y2="296" stroke="#424242" stroke-width="1.8" stroke-linecap="round"/>
      <!-- body -->
      <line x1="204" y1="324" x2="204" y2="344" stroke="#424242" stroke-width="2.2" stroke-linecap="round"/>
      <!-- arm to mast -->
      <path d="M204 332 Q218 324 226 328" stroke="#424242" stroke-width="2" fill="none" stroke-linecap="round"/>
      <!-- other arm -->
      <line x1="204" y1="332" x2="193" y2="338" stroke="#424242" stroke-width="2" stroke-linecap="round"/>
      <!-- waves -->
      <path d="M40 406 Q88 382 138 406 Q188 430 238 406 Q288 382 338 406 Q382 426 420 406"
        stroke="#424242" stroke-width="2.2" fill="none" stroke-linecap="round"/>
      <path d="M28 434 Q80 408 136 434 Q192 460 246 434 Q300 408 356 434 Q396 452 432 432"
        stroke="#424242" stroke-width="1.6" fill="none" stroke-linecap="round" opacity="0.42"/>
      <path d="M48 458 Q100 436 158 458 Q212 478 268 457 Q318 438 370 458 Q406 471 436 457"
        stroke="#424242" stroke-width="1" fill="none" stroke-linecap="round" opacity="0.22"/>
      <!-- water fill -->
      <path d="M0 418 Q80 396 180 418 Q280 440 380 418 Q432 408 480 418 L480 560 L0 560Z"
        fill="#FDB44E" opacity="0.1"/>
    </svg>
  </div>
</section>

<!-- STATS -->
<div class="stats-bar">
  <div class="stat-item">
    <div class="stat-num">3</div>
    <div class="stat-label">Формата участия</div>
  </div>
  <div class="stat-item">
    <div class="stat-num">Строгино</div>
    <div class="stat-label">Водноспортивная база МКС</div>
  </div>
